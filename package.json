{
  "name": "fit-check",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"{api,packages,docs}/**/*.{ts,tsx,js,jsx,json,md}\" \"*.{json,md,ts}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "api:dev": "API_ENV=dev node --env-file=.env --import tsx api/server.ts",
    "api:prod": "API_ENV=prod node --env-file=.env --import tsx api/server.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts"
  },
  "imports": {
    "#packages/*": "./packages/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.17.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
