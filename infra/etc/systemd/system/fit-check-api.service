[Unit]
Description=fit-check API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=fitcheck
WorkingDirectory=/srv/fit-check/api
EnvironmentFile=/srv/fit-check/.env
ExecStart=/usr/bin/node server.cjs
Restart=always
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
