{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    // node is only needed for vite.config.ts.
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    "noImplicitAny": false, // TEMP - remove once the web components are typed
    "paths": {
      "@/*": ["./*"],
      "@packages/*": ["../packages/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
