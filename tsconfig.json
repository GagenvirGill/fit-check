{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  // Shared settings for api/ and web/, which extend this file. On its own it
  // checks the root config files, packages/ and scripts/.
  "include": ["*.ts", "packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["**/dist", "**/node_modules"]
}
