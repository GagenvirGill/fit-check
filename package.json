{
  "name": "fit-check",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "prettier --write \"{api,packages,docs}/**/*.{ts,tsx,js,jsx,json,md}\" \"*.{json,md,ts}\"",
    "lint": "eslint .",
    "typecheck": "tsc -p api && tsc -p web && tsc",
    "api:dev": "node --env-file=.env.dev --import tsx api/server.ts",
    "api:build": "rm -rf dist && esbuild api/server.ts api/migrate.ts --bundle --platform=node --target=node24 --format=cjs --external:pg-native --minify-whitespace --minify-syntax --outdir=dist --out-extension:.js=.cjs && cp -R packages/db/migrations dist/migrations",
    "api:prod": "npm run api:build && node --env-file=.env.prod dist/server.cjs",
    "web:dev": "vite web --mode dev",
    "web:build": "vite build web --mode prod",
    "web:preview": "vite preview web",
    "db:generate": "node --env-file=.env.dev node_modules/.bin/drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "node --env-file=.env.dev node_modules/.bin/drizzle-kit migrate --config packages/db/drizzle.config.ts"
  },
  "imports": {
    "#packages/*": "./packages/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "image-size": "^2.0.2",
    "jotai": "^2.19.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "onnxruntime-web": "^1.21.0-dev.20250114-228dd16893",
    "pg": "^8.20.0",
    "queue": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
